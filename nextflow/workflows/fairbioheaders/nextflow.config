// SPDX-License-Identifier: MPL-2.0
// Configuration of the FAIR-bioHeaders workflow (main.nf). Dockstore reads the
// manifest block; .dockstore.yml at the repository root points here.

manifest {
    name            = 'FAIR-bioHeaders/FAIR-bioHeaders-Tools'
    description     = 'Add FAIR-bioHeaders (FHR, FHGFF3) metadata headers to FASTA, GFA or GFF3 files and verify them'
    homePage        = 'https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version         = '0.8.1'
    license         = 'MPL-2.0'
    author          = 'David Molik, Adam Wright'
    contributors    = [
        [name: 'David Molik', affiliation: 'USDA ARS ABADRU', email: 'molik@fhref.org', orcid: 'https://orcid.org/0000-0003-3192-6538', contribution: ['author', 'maintainer']],
        [name: 'Adam Wright', affiliation: 'OICR', email: 'wright@fhref.org', orcid: 'https://orcid.org/0000-0002-5719-4024', contribution: ['author', 'maintainer']],
    ]
}

params {
    // Samplesheet (CSV with the columns id,metadata,sequence), or one file given by
    // metadata and sequence (and optionally id).
    input    = null
    metadata = null
    sequence = null
    id       = null
    outdir   = 'results'
}

// The fair-bioheaders release the workflow runs. The modules pin the BioContainers
// image and Bioconda package of the same release, which lack the optional pyld
// dependency (the jsonld extra) that reading JSON-LD in other than the canonical form
// needs. These settings add it: the project's own image (built by
// .github/workflows/container.yml) has it, and environment.yml adds pyld from
// conda-forge to the Bioconda package. Keep the image version and the Bioconda pin
// in environment.yml equal to the modules' pins.
process {
    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    withName: 'FAIRBIOHEADERS_.*' {
        container = 'ghcr.io/fair-bioheaders/fair-bioheaders:0.8.1'
        conda     = "${projectDir}/environment.yml"
    }
    withName: 'FAIRBIOHEADERS_COMBINE' {
        publishDir = [path: { "${params.outdir}/combine" }, mode: 'copy']
    }
    withName: 'FAIRBIOHEADERS_VERIFY' {
        publishDir = [path: { "${params.outdir}/verify" }, mode: 'copy']
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    test {
        params.input = "${projectDir}/assets/test/samplesheet.csv"
    }
}
