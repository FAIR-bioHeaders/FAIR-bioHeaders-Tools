config {
    // Tests of the nf-core-style modules in modules/nf-core/fairbioheaders.
    // Run from this directory: nf-test test --profile docker
    testsDir = "."
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile = "tests/nextflow.config"
    profile = ""

    plugins {
        load "nft-utils@1.2.1"
    }
}
